RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"

DEFAULTS = {
    # "wallpaper": what bgmonad shows on each output (else ~/.config/wallpaper);
    # "screenshot": the screen itself; a path to an image; or a colour "#1e1e2e"
    "background": "wallpaper",
    "blur": 0.025,          # blur radius, as a fraction of the screen height (0 = sharp)
    "dim": 0.38,            # 0 = the picture as it is, 1 = black
    # "flow": the picture flows slowly, like bgmonad's; "drift": a slow zoom
    # and pan; "none": still
    "animation": "flow",
    "flow": 0.07,           # how far the flow moves the picture, in screen heights
    "flow_speed": 1.0,      # 1 = a swirl takes 10 to 30 seconds
    "fps": 20,              # of the animation (it is drawn only while the screen is on)
    "fade": True,           # start from a screenshot and crossfade (needs grim)
    "music": True,          # what is playing (MPRIS), with previous / play-pause / next
    "clock": "%H:%M",
    "date": "%A, %-d %B",
    "avatar": "",           # an image; else ~/.face, AccountsService, the initial
    "name": "",             # shown under the avatar; else the full name or the login
    "pam_service": "",      # else "locklet" if /etc/pam.d/locklet exists, else "login"
}


def load_config():
    cfg = dict(DEFAULTS)
    mine = {}
    try:
        with open(os.path.join(CONFIG_DIR, "config.json")) as f:
            mine = json.load(f)
    except FileNotFoundError:
        pass
    except (OSError, ValueError) as e:
        print(f"locklet: config.json: {e}", file=sys.stderr)
    # 0.1.0 had "drift": true / false instead of "animation"
    if "drift" in mine and "animation" not in mine:
        mine["animation"] = "drift" if mine["drift"] else "none"
    cfg.update(mine)
    if cfg["animation"] not in ("flow", "drift", "none"):
        print(f"locklet: unknown animation {cfg['animation']!r}, using \"flow\"", file=sys.stderr)
        cfg["animation"] = "flow"
    return cfg


def log(*a):
    print("locklet:", *a, file=sys.stderr, flush=True)


# --------------------------------------------------------------------------
# PAM, through ctypes (no python module needed)

PAM_PROMPT_ECHO_OFF, PAM_PROMPT_ECHO_ON, PAM_ERROR_MSG, PAM_TEXT_INFO = 1, 2, 3, 4
PAM_SUCCESS, PAM_BUF_ERR, PAM_AUTH_ERR, PAM_CONV_ERR = 0, 5, 7, 19


class PamMessage(ctypes.Structure):
    _fields_ = [("msg_style", ctypes.c_int), ("msg", ctypes.c_char_p)]


class PamResponse(ctypes.Structure):
    _fields_ = [("resp", ctypes.c_void_p), ("resp_retcode", ctypes.c_int)]


PAM_CONV_FUNC = ctypes.CFUNCTYPE(
    ctypes.c_int, ctypes.c_int,
    ctypes.POINTER(ctypes.POINTER(PamMessage)),
    ctypes.POINTER(ctypes.POINTER(PamResponse)),
    ctypes.c_void_p)


class PamConv(ctypes.Structure):
    _fields_ = [("conv", PAM_CONV_FUNC), ("appdata_ptr", ctypes.c_void_p)]


_libpam = _libc = None


def _pam_libs():
    global _libpam, _libc
    if _libpam is None:
        _libpam = ctypes.CDLL(ctypes.util.find_library("pam") or "libpam.so.0")
        _libpam.pam_start.argtypes = [ctypes.c_char_p, ctypes.c_char_p,
                                      ctypes.POINTER(PamConv), ctypes.POINTER(ctypes.c_void_p)]
        _libpam.pam_authenticate.argtypes = [ctypes.c_void_p, ctypes.c_int]
        _libpam.pam_end.argtypes = [ctypes.c_void_p, ctypes.c_int]
        _libpam.pam_strerror.argtypes = [ctypes.c_void_p, ctypes.c_int]
        _libpam.pam_strerror.restype = ctypes.c_char_p
        _libc = ctypes.CDLL(None)
        _libc.calloc.argtypes = [ctypes.c_size_t, ctypes.c_size_t]
        _libc.calloc.restype = ctypes.c_void_p
        _libc.strdup.argtypes = [ctypes.c_char_p]
        _libc.strdup.restype = ctypes.c_void_p
    return _libpam, _libc


def pam_service(cfg):
    if cfg.get("pam_service"):
        return cfg["pam_service"]
    return "locklet" if os.path.exists("/etc/pam.d/locklet") else "login"


def authenticate(service, user, password):
    """(ok, message). Blocks (PAM may wait a couple of seconds after a
    wrong password), so call it from a thread."""
    pam, libc = _pam_libs()
    secret = password.encode()
    said = []

    def conv(n, messages, responses, _data):
        try:
            arr = libc.calloc(n, ctypes.sizeof(PamResponse))
            if not arr:
                return PAM_BUF_ERR
            resp = ctypes.cast(arr, ctypes.POINTER(PamResponse))
            for i in range(n):
                m = messages[i].contents
                if m.msg_style in (PAM_PROMPT_ECHO_OFF, PAM_PROMPT_ECHO_ON):
                    resp[i].resp = libc.strdup(secret)   # PAM frees it
                elif m.msg_style in (PAM_ERROR_MSG, PAM_TEXT_INFO) and m.msg:
                    said.append(m.msg.decode(errors="replace").strip())
            responses[0] = resp
            return PAM_SUCCESS
        except Exception:
            return PAM_CONV_ERR

    callback = PAM_CONV_FUNC(conv)
    conversation = PamConv(callback, None)
    handle = ctypes.c_void_p()
    r = pam.pam_start(service.encode(), user.encode(), ctypes.byref(conversation), ctypes.byref(handle))
    if r != PAM_SUCCESS:
        return False, f"PAM could not start ({service})"
    r = pam.pam_authenticate(handle, 0)
    why = "" if r == PAM_SUCCESS else (pam.pam_strerror(handle, r) or b"").decode(errors="replace")
    pam.pam_end(handle, r)
    if r == PAM_SUCCESS:
        return True, ""
    # pam_faillock says why in two lines: "The account is locked due to 3
    # failed logins." and "(10 minutes left to unlock)"
    said = [s for s in said if s]
    if said:
        return False, " ".join(said)
    return False, "Wrong password" if r == PAM_AUTH_ERR else why


