        self.backdrop = Backdrop(cfg)
        self.set_child(self.backdrop)
        shade = Gtk.Box()
        shade.add_css_class("shade")
        shade.set_can_target(False)
        self.add_overlay(shade)

        # the date and the clock, high up
        top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        top.add_css_class("top")
        top.set_halign(Gtk.Align.CENTER)
        top.set_valign(Gtk.Align.START)
        top.set_margin_top(int((geo.height if geo else 1080) * 0.10))
        self.date = Gtk.Label(css_classes=["date"])
        self.clock = Gtk.Label(css_classes=["clock"])
        self.date.set_can_target(False)
        self.clock.set_can_target(False)
