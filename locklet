    def update(self, state, texture):
        if state is None:
            self.set_reveal_child(False)
            return
        self.player.set_label(state["player"].upper())
        self.title.set_label(state["title"] or state["artist"])
        self.artist.set_label(state["artist"] if state["title"] else "")
        self.artist.set_visible(bool(state["artist"] and state["title"]))
        self.play.get_child().set_label("pause" if state["status"] == "Playing" else "play_arrow")
        self.prev.set_sensitive(state["can_prev"])
        self.next.set_sensitive(state["can_next"])
        if texture is not None:
            self.picture.set_from_paintable(texture)
            self.art_stack.set_visible_child_name("art")
        else:
            self.art_stack.set_visible_child_name("none")
        self.set_reveal_child(True)


class LockView(Gtk.Overlay):
