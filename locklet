def bgmonad_wallpapers():
    """{output: image} from the running bgmonad, or {}."""
    path = os.path.join(RUNTIME_DIR, f"bgmonad-{os.environ.get('WAYLAND_DISPLAY', 'wayland-0')}.sock")
    if not os.path.exists(path):
        return {}
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.4)
            s.connect(path)
            s.sendall(b"status\n")
            data = b""
            while True:
                chunk = s.recv(4096)
                if not chunk:
                    break
                data += chunk
    except OSError:
        data = b""
    if not data and shutil.which("bgmonad"):
        try:
            data = subprocess.run(["bgmonad", "status"], capture_output=True, timeout=0.6).stdout
        except (OSError, subprocess.TimeoutExpired):
            data = b""
    out = {}
    for line in data.decode(errors="replace").splitlines():
        name, sep, rest = line.partition(": ")
        if sep and rest.strip().startswith("/"):
            out[name.strip()] = rest.strip()
    return out


def screenshot(connector):
    """PNG bytes of one output (uncompressed, it is only read back), or None."""
    if not shutil.which("grim"):
        return None
    cmd = ["grim", "-l", "0"] + (["-o", connector] if connector else []) + ["-"]
    try:
        r = subprocess.run(cmd, capture_output=True, timeout=3)
        return r.stdout if r.returncode == 0 and r.stdout else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def blurred_rgb(source, width, height, blur):
    """(w, h, bytes RGB) of the picture covering width x height, blurred;
    `source` is a path or PNG bytes. Done small: the GPU scales it up and,
    blurred, it looks the same. None if it cannot be read."""
    try:
        import io
        from PIL import Image, ImageFilter, ImageOps
    except ImportError:
        return None
    try:
        im = Image.open(io.BytesIO(source) if isinstance(source, bytes) else source)
        im = ImageOps.exif_transpose(im).convert("RGB")
    except Exception as e:
        log(f"cannot read the background: {e}")
        return None
    # a quarter of the screen is plenty for a blurred picture; sharp, all of it
    k = 0.25 if blur > 0 else 1.0
    tw, th = max(1, int(width * k)), max(1, int(height * k))
    im = ImageOps.fit(im, (tw, th), Image.Resampling.LANCZOS)
    if blur > 0:
        im = im.filter(ImageFilter.GaussianBlur(blur * th))
    return im.width, im.height, im.tobytes()


class FlowField:
    """bgmonad's flow, for a blurred picture: a sum of slow shear waves
    travelling in different directions (periods that share no factor, so
    it never repeats), evaluated on a coarse grid; Pillow warps the picture
    through the grid (in C). Blurred, the picture can be warped at an
    eighth of the screen's resolution and scaled up by the GPU: about 2 ms
    a frame."""

    # (direction in turns, waves per screen height, period in seconds, weight, phase)
    WAVES = [(0.07, 0.55, 29, 1.00, 0.0), (0.31, 0.85, 19, 0.75, 1.3),
             (0.58, 1.30, 13, 0.50, 2.9), (0.83, 1.90, 11, 0.30, 4.1)]

    def __init__(self, image, width, height, margin, amount, speed):
        from PIL import Image
        self.Image = Image
        self.image, self.width, self.height, self.margin = image, width, height, margin
        self.speed = speed
        total = sum(w for *_, w, _ph in self.WAVES)
        self.waves = [(math.cos(2 * math.pi * a), math.sin(2 * math.pi * a), 2 * math.pi * f,
                       amount * w / total, p, ph) for a, f, p, w, ph in self.WAVES]
        self.gx = 16
        self.gy = max(4, round(16 * height / max(1, width)))
        self.boxes = [(round(i * width / self.gx), round(j * height / self.gy),
                       round((i + 1) * width / self.gx), round((j + 1) * height / self.gy))
                      for j in range(self.gy) for i in range(self.gx)]

    def frame(self, t):
        """RGB bytes, width x height, of the picture at time t (seconds)."""
        W, H, m, gx, gy = self.width, self.height, self.margin, self.gx, self.gy
        t *= self.speed
        node = {}
        for j in range(gy + 1):
            for i in range(gx + 1):
                x, y = i / gx * W / H, j / gy           # in screen heights
                dx = dy = 0.0
                for nx, ny, k, amp, period, ph in self.waves:
                    s = amp * math.sin(k * (x * nx + y * ny) + 2 * math.pi * t / period + ph)
                    dx -= ny * s                         # across the wave: nothing is squeezed
                    dy += nx * s
                node[i, j] = (m + i / gx * W + dx * H, m + j / gy * H + dy * H)
        mesh = []
        for n, box in enumerate(self.boxes):
            i, j = n % gx, n // gx
            a, b, c, d = node[i, j], node[i, j + 1], node[i + 1, j + 1], node[i + 1, j]
            mesh.append((box, (*a, *b, *c, *d)))
        return self.image.transform((W, H), self.Image.Transform.MESH, mesh,
                                    self.Image.Resampling.BILINEAR).tobytes()


def prepare_flow(source, width, height, blur, amount, speed):
    """A FlowField for the picture covering width x height, or None (no
    Pillow, or the picture cannot be read)."""
    try:
        import io
        from PIL import Image, ImageFilter, ImageOps
    except ImportError:
        return None
    try:
        im = Image.open(io.BytesIO(source) if isinstance(source, bytes) else source)
        im = ImageOps.exif_transpose(im).convert("RGB")
    except Exception as e:
        log(f"cannot read the background: {e}")
        return None
    # blurred, an eighth of the resolution is plenty; sharp, a half
    k = 1 / 8 if blur >= 0.01 else 1 / 2
    W, H = max(16, int(width * k)), max(9, int(height * k))
    amount = min(max(0.0, float(amount)), 0.08)
    m = int(amount * H) + 3                              # room for the waves at the edges
    im = ImageOps.fit(im, (W + 2 * m, H + 2 * m), Image.Resampling.LANCZOS)
    if blur > 0:
        im = im.filter(ImageFilter.GaussianBlur(blur * H))
    return FlowField(im, W, H, m, amount, float(speed))


def find_avatar(cfg):
    user = pwd.getpwuid(os.getuid()).pw_name
    for p in [os.path.expanduser(cfg.get("avatar") or ""), os.path.expanduser("~/.face"),
              os.path.expanduser("~/.face.icon"), f"/var/lib/AccountsService/icons/{user}"]:
        if p and os.path.isfile(p):
            return p
    return None


def display_name(cfg):
    if cfg.get("name"):
        return cfg["name"]
    pw = pwd.getpwuid(os.getuid())
    return pw.pw_gecos.split(",")[0].strip() or pw.pw_name


