# State shared by the lock screen and the idle daemon, in $XDG_RUNTIME_DIR

LOCK_FILE = os.path.join(RUNTIME_DIR, "locklet.lock")          # held while locklet runs
LOCKED_FILE = os.path.join(RUNTIME_DIR, "locklet.locked")      # pid, once the session is locked
IDLE_FILE = os.path.join(RUNTIME_DIR, "locklet-idle.lock")     # held by the idle daemon, its pid
PAUSED_FILE = os.path.join(RUNTIME_DIR, "locklet-idle.paused") # exists while paused


def pid_alive(pid):
    try:
        with open(f"/proc/{int(pid)}/cmdline", "rb") as f:
            return b"locklet" in f.read()
    except (OSError, ValueError):
        return False


def read_pid(path):
    try:
        with open(path) as f:
            return int(f.read().strip() or 0)
    except (OSError, ValueError):
        return 0


def is_locked():
    pid = read_pid(LOCKED_FILE)
    return bool(pid) and pid_alive(pid)


def idle_daemon_pid():
    pid = read_pid(IDLE_FILE)
    return pid if pid and pid != os.getpid() and pid_alive(pid) else 0


def hold(path):
    """Take the lock file at `path` and write our pid in it; None if
    another process holds it."""
    f = open(path, "a+")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        f.close()
        return None
    f.seek(0)
    f.truncate()
    f.write(str(os.getpid()))
    f.flush()
    return f


def parse_seconds(v):
    """600, "600", "10m", "1h", "90s" -> seconds; 0 / false / "" -> 0."""
    if v in (None, False, "", 0):
        return 0
    s = str(v).strip().lower()
    mult = {"s": 1, "m": 60, "h": 3600}.get(s[-1:], None)
    try:
        return int(float(s[:-1]) * mult) if mult else int(float(s))
    except ValueError:
        raise SystemExit(f"locklet: not a duration: {v!r} (600, \"10m\", \"1h\")")


# --------------------------------------------------------------------------
# The idle daemon: `locklet idle`. It speaks the Wayland wire protocol
# itself (only four interfaces are needed) and logind's D-Bus API, so it
# needs nothing but the standard library and Gio, and no GTK.

IDLE_DEFAULTS = {
    "lock": "10m",               # lock after this long without input (0: never)
    "screen_off": 0,             # screens off after this long, locked or not (0: never)
    "screen_off_locked": 0,      # screens off after this long once locked (0: never; "1m")
    "lock_before_sleep": True,   # lock before suspending or hibernating
}


class Wire:
    """The client side of the Wayland wire protocol, just enough to bind
    globals, send requests and get events: (object id, opcode, payload)."""

    def __init__(self):
        name = os.environ.get("WAYLAND_DISPLAY", "wayland-0")
        path = name if name.startswith("/") else os.path.join(RUNTIME_DIR, name)
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path)
        self.next_id = 2
        self.handlers = {}          # id -> f(opcode, payload)
        self.buf = b""
        self.handlers[1] = self.on_display

    def new_id(self, handler=None):
        i = self.next_id
        self.next_id += 1
        if handler:
            self.handlers[i] = handler
        return i

    def send(self, obj, opcode, *args):
        body = b""
        for a in args:
            if isinstance(a, str):
                data = a.encode() + b"\0"
                body += struct.pack("<I", len(data)) + data + b"\0" * (-len(data) % 4)
            else:
                body += struct.pack("<I", a)
        self.sock.sendall(struct.pack("<IHH", obj, opcode, 8 + len(body)) + body)

    def read(self):
        """Read what arrived and dispatch it; False when the compositor is gone."""
        try:
            data = self.sock.recv(65536)
        except OSError:
            return False
        if not data:
            return False
        self.buf += data
        while len(self.buf) >= 8:
            obj, opcode, size = struct.unpack("<IHH", self.buf[:8])
            if len(self.buf) < size:
                break
            body, self.buf = self.buf[8:size], self.buf[size:]
            h = self.handlers.get(obj)
            if h:
                h(opcode, body)
        return True

    def on_display(self, opcode, body):
        if opcode == 0:                              # error
            obj, code = struct.unpack("<II", body[:8])
            raise SystemExit(f"locklet idle: Wayland error {code} on object {obj}: {wl_string(body, 8)[0]}")
        if opcode == 1:                              # delete_id
            self.handlers.pop(struct.unpack("<I", body[:4])[0], None)

    def roundtrip(self, timeout=None):
        done = []
        cb = self.new_id(lambda op, _b: done.append(1))
        self.send(1, 0, cb)                          # wl_display.sync
        self.sock.settimeout(timeout)
        try:
            while not done:
                if not self.read():
                    raise SystemExit("locklet idle: the compositor went away")
        finally:
            self.sock.settimeout(None)


def wl_string(body, off):
    n = struct.unpack("<I", body[off:off + 4])[0]
    s = body[off + 4:off + 4 + max(0, n - 1)].decode(errors="replace")
    return s, off + 4 + n + (-n % 4)


def gi_require(name, version):
    import gi
    gi.require_version(name, version)


class IdleDaemon:
    def __init__(self, cfg):
        from gi.repository import GLib
        self.GLib = GLib
        self.cfg = cfg
        self.lock_after = parse_seconds(cfg["lock"])
        self.off_after = parse_seconds(cfg["screen_off"])
        self.off_locked_after = parse_seconds(cfg["screen_off_locked"])
        self.paused = False
        self.screens_off = False
        self.notifications = {}     # what -> notification id
        self.outputs = {}           # global name -> (wl_output id, power id)
        self.seat = self.notifier = self.power_manager = None
        self.inhibitor = None       # logind delay lock (an fd)
        self.wl = Wire()
        self.registry = self.wl.new_id(self.on_global)
        self.wl.send(1, 1, self.registry)            # wl_display.get_registry
        self.wl.roundtrip()
        if not self.notifier or not self.seat:
            raise SystemExit("locklet idle: the compositor has no ext-idle-notify-v1")
        try:
            os.unlink(PAUSED_FILE)
        except FileNotFoundError:
            pass
        self.arm()

    # ---- Wayland

    def bind(self, name, iface, version, handler=None):
        i = self.wl.new_id(handler)
        self.wl.send(self.registry, 0, name, iface, version, i)   # wl_registry.bind
        return i

    def on_global(self, opcode, body):
        if opcode == 1:                                           # global_remove
            name = struct.unpack("<I", body[:4])[0]
            if name in self.outputs:
                _out, power = self.outputs.pop(name)
                if power:
                    self.wl.send(power, 1)                        # zwlr_output_power_v1.destroy
                    self.wl.handlers.pop(power, None)
            return
        name = struct.unpack("<I", body[:4])[0]
        iface, off = wl_string(body, 4)
        if iface == "wl_seat" and self.seat is None:
            self.seat = self.bind(name, iface, 1)
        elif iface == "ext_idle_notifier_v1":
            self.notifier = self.bind(name, iface, 1)
        elif iface == "zwlr_output_power_manager_v1":
            self.power_manager = self.bind(name, iface, 1)
            for n in list(self.outputs):
                self.add_power(n)
        elif iface == "wl_output":
            self.outputs[name] = (self.bind(name, iface, 1), None)
            self.add_power(name)

    def add_power(self, name):
        out, power = self.outputs[name]
        if self.power_manager and not power:
            def on_power(op, _b, name=name):
                if op == 1 and name in self.outputs:                # failed
                    self.outputs[name] = (self.outputs[name][0], None)
            power = self.wl.new_id(on_power)
            self.wl.send(self.power_manager, 0, power, out)       # get_output_power
            self.outputs[name] = (out, power)
            if self.screens_off:
                self.wl.send(power, 0, 0)

    def set_screens(self, on):
        if self.screens_off == (not on):
            return
        self.screens_off = not on
        for _out, power in self.outputs.values():
            if power:
                self.wl.send(power, 0, 1 if on else 0)            # set_mode(on/off)

    def watch(self, what, seconds, idled, resumed=None):
        """(Re)start an idle timer: idled() after `seconds` without input."""
        old = self.notifications.pop(what, None)
        if old:
            self.wl.send(old, 0)                                  # destroy
            self.wl.handlers.pop(old, None)
        if seconds <= 0 or self.paused:
            return

        def on_event(op, _b):
            if op == 0:
                idled()
            elif op == 1 and resumed:
                resumed()

        n = self.wl.new_id(on_event)
        self.wl.send(self.notifier, 1, n, seconds * 1000, self.seat)   # get_idle_notification
        self.notifications[what] = n

    def arm(self):
        self.watch("lock", self.lock_after, self.lock_now)
        self.watch("off", self.off_after, lambda: self.set_screens(False), lambda: self.set_screens(True))
        self.watch("off-locked", self.off_locked_after, self.off_if_locked, lambda: self.set_screens(True))

    def off_if_locked(self):
        if is_locked():
            self.set_screens(False)

    # ---- locking

    def lock_now(self):
        pid = read_pid(LOCK_FILE)
        if not (pid and pid_alive(pid)):                 # not running already
            script = os.path.realpath(sys.argv[0])
            subprocess.Popen([sys.executable, script], start_new_session=True,
                             stdin=subprocess.DEVNULL)

    def on_locked(self):
        # locklet tells us when the session is locked: the "screens off
        # while locked" timer counts from now
        self.watch("off-locked", self.off_locked_after, self.off_if_locked, lambda: self.set_screens(True))
        return True

    # ---- suspend (logind)

    def setup_logind(self):
        if not self.cfg["lock_before_sleep"]:
            return
        from gi.repository import Gio
        self.Gio = Gio
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        except Exception as e:
            log(f"idle: no system bus, not locking before sleep ({e})")
            return
        self.bus.signal_subscribe("org.freedesktop.login1", "org.freedesktop.login1.Manager",
                                  "PrepareForSleep", "/org/freedesktop/login1", None,
                                  Gio.DBusSignalFlags.NONE, self.on_prepare_for_sleep)
        self.inhibit()

    def inhibit(self):
        if self.inhibitor is not None:
            return
        GLib, Gio = self.GLib, self.Gio
        try:
            res, fds = self.bus.call_with_unix_fd_list_sync(
                "org.freedesktop.login1", "/org/freedesktop/login1", "org.freedesktop.login1.Manager",
                "Inhibit", GLib.Variant("(ssss)", ("sleep", "locklet", "Lock the screen before sleeping", "delay")),
                GLib.VariantType("(h)"), Gio.DBusCallFlags.NONE, -1, None, None)
            self.inhibitor = fds.get(res.unpack()[0])
        except Exception as e:
            log(f"idle: logind would not let us delay sleep ({e})")

    def release(self):
        if self.inhibitor is not None:
            os.close(self.inhibitor)
            self.inhibitor = None
        return False

    def on_prepare_for_sleep(self, _c, _s, _p, _i, _n, params):
        going = params.unpack()[0]
        if not going:                               # woke up
            self.set_screens(True)
            self.inhibit()
            return
        if self.paused or is_locked():
            self.release()
            return
        self.lock_now()
        started = time.monotonic()

        def wait():
            # sleep once the lock screen is up, or after 3 seconds anyway
            if is_locked() or time.monotonic() - started > 3:
                self.GLib.timeout_add(150, self.release)   # one frame for the compositor
                return False
            return True

        self.GLib.timeout_add(50, wait)

    # ---- pause

    def toggle_pause(self):
        self.paused = not self.paused
        if self.paused:
            open(PAUSED_FILE, "w").close()
        else:
            try:
                os.unlink(PAUSED_FILE)
            except FileNotFoundError:
                pass
        self.arm()
        log("idle: paused" if self.paused else "idle: resumed")
        return True

    # ---- loop

    def run(self):
        GLib = self.GLib
        loop = GLib.MainLoop()

        def on_wayland(_fd, cond):
            if cond & (GLib.IOCondition.HUP | GLib.IOCondition.ERR) or not self.wl.read():
                loop.quit()
                return False
            return True

        try:
            gi_require("GLibUnix", "2.0")
            from gi.repository import GLibUnix
            fd_add, signal_add = GLibUnix.fd_add_full, GLibUnix.signal_add
        except (ValueError, ImportError):
            fd_add, signal_add = GLib.unix_fd_add_full, GLib.unix_signal_add
        fd_add(GLib.PRIORITY_DEFAULT, self.wl.sock.fileno(),
               GLib.IOCondition.IN | GLib.IOCondition.HUP | GLib.IOCondition.ERR, on_wayland)
        signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self.toggle_pause)
        signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2, self.on_locked)
        for s in (signal.SIGTERM, signal.SIGINT):
            signal_add(GLib.PRIORITY_DEFAULT, s, lambda: loop.quit() or False)
        self.setup_logind()
        loop.run()
        # screens back on before going; never wait long for that
        self.set_screens(True)
        try:
            self.wl.roundtrip(timeout=1)
        except (SystemExit, OSError):
            pass


def idle_command(args):
    sub = args[0] if args else ""
    if sub in ("pause", "resume", "toggle", "status"):
        pid = idle_daemon_pid()
        paused = os.path.exists(PAUSED_FILE)
        if sub == "status":
            print("not running" if not pid else ("paused" if paused else "active"))
            return 0
        if not pid:
            print("locklet: the idle daemon is not running (locklet idle)", file=sys.stderr)
            return 1
        if sub == "toggle" or (sub == "pause") != paused:
            os.kill(pid, signal.SIGUSR1)
        return 0
    if sub:
        print(f"locklet: unknown idle command {sub!r} (see locklet --help)", file=sys.stderr)
        return 2
    # a new daemon replaces the one running (to pick up a changed config)
    old = idle_daemon_pid()
    if old:
        os.kill(old, signal.SIGTERM)
    held = None
    for _ in range(40):
        held = hold(IDLE_FILE)
        if held:
            break
        time.sleep(0.05)
    if not held:
        print("locklet: another idle daemon would not stop", file=sys.stderr)
        return 1
    cfg = dict(IDLE_DEFAULTS)
    cfg.update(load_config().get("idle") or {})
    try:
        import gi
        gi.require_version("GLib", "2.0")
        IdleDaemon(cfg).run()
    except ConnectionError as e:
        log(f"idle: cannot connect to the compositor: {e}")
        return 1
    return 0


def tell_idle_daemon_locked():
    pid = idle_daemon_pid()
    if pid:
        try:
            os.kill(pid, signal.SIGUSR2)
        except OSError:
            pass


