        self.media = MediaCard(app)
        top.append(self.media)
        self.add_overlay(top)

        # the user and the password, low down
        form = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        form.add_css_class("form")
        form.set_halign(Gtk.Align.CENTER)
        form.set_valign(Gtk.Align.END)
        form.set_margin_bottom(int((geo.height if geo else 1080) * 0.12))
        form.append(Avatar(app.avatar, app.name))
        form.append(Gtk.Label(label=app.name, css_classes=["name"]))

        self.pill = Gtk.Box(css_classes=["pill"])
        self.pill.set_halign(Gtk.Align.CENTER)
        self.entry = Gtk.PasswordEntry()
        self.entry.set_hexpand(True)
        self.entry.set_valign(Gtk.Align.CENTER)
        self.entry.set_property("placeholder-text", "Enter Password")
        self.entry.set_show_peek_icon(True)
        self.entry.connect("activate", lambda _e: self.submit())
        self.entry.connect("changed", self.on_changed)
        self.pill.append(self.entry)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(120)
        self.go = Gtk.Button(css_classes=["go"])
        self.go.set_child(Gtk.Label(label="arrow_forward", css_classes=["icon"]))
        self.go.set_focusable(False)
        self.go.connect("clicked", lambda _b: self.submit())
        self.spinner = Gtk.Spinner()
        self.stack.add_named(self.go, "go")
        self.stack.add_named(self.spinner, "busy")
        self.pill.append(self.stack)
        form.append(self.pill)

        self.status = Gtk.Label(css_classes=["status"])
        form.append(self.status)
        if app.preview:
            form.append(Gtk.Label(label="preview: Esc closes", css_classes=["hint"]))
        self.add_overlay(form)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        # a click anywhere gives the field the focus back
        click = Gtk.GestureClick()
        click.connect("pressed", lambda *_: self.entry.grab_focus())
        self.add_controller(click)

        self.error = ""
        self.tick_clock()
        self.connect("map", self.on_map)

    def on_map(self, _w):
        self.entry.grab_focus()
        GLib.timeout_add(30, lambda: self.add_css_class("shown") or False)

    def tick_clock(self):
        now = time.localtime()
        self.clock.set_label(time.strftime(self.app.cfg["clock"], now))
        self.date.set_label(time.strftime(self.app.cfg["date"], now))

    def on_changed(self, _e):
        has = bool(self.entry.get_text())
        (self.go.add_css_class if has else self.go.remove_css_class)("ready")
        if has and self.error:
            self.app.set_status("")

    def on_key(self, _c, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            if self.app.preview and not self.entry.get_text():
                self.app.quit()
            self.entry.set_text("")
            return True
        if not self.entry.has_focus() and self.entry.get_sensitive():
            self.entry.grab_focus()
        return False

    def submit(self):
        self.app.submit(self.entry.get_text())

    def set_busy(self, busy):
        self.entry.set_sensitive(not busy)
        self.stack.set_visible_child_name("busy" if busy else "go")
        self.spinner.set_spinning(busy)
        if not busy:
            self.entry.grab_focus()

    def show_status(self, text, error=False):
        self.error = text if error else ""
        self.status.set_label(text)
        (self.status.add_css_class if error else self.status.remove_css_class)("error")
        (self.pill.add_css_class if error else self.pill.remove_css_class)("error")

    def shake(self):
        self.entry.set_text("")
        self.pill.remove_css_class("shake")
        GLib.idle_add(lambda: self.pill.add_css_class("shake") or False)
        GLib.timeout_add(500, lambda: self.pill.remove_css_class("shake") or False)

    def leave(self):
        self.add_css_class("leaving")
        self.backdrop.leave()


class Locklet(Gtk.Application):
    def __init__(self, preview):
        super().__init__(application_id="io.github.prietus.locklet" + (".preview" if preview else ""),
                         flags=gi.repository.Gio.ApplicationFlags.NON_UNIQUE)
        self.preview = preview
        self.cfg = load_config()
        self.user = pwd.getpwuid(os.getuid()).pw_name
        self.name = display_name(self.cfg)
        self.avatar = find_avatar(self.cfg)
        self.service = pam_service(self.cfg)
        self.views = []
        self.shots = {}
        self.wallpapers = {}
        self.checking = False
        self.unlocking = False
        self.lock = None
        self.pool = ThreadPoolExecutor(max_workers=4)
        self.media = None           # Media, when "music" is on
        self.media_state = None
        self.covers = {}            # art url -> Gdk.Texture (None: could not be had)

    # ---- setup

    def do_startup(self):
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        user_css = os.path.join(CONFIG_DIR, "style.css")
        if os.path.exists(user_css):
            mine = Gtk.CssProvider()
            mine.load_from_path(user_css)
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), mine,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_USER)

    def do_activate(self):
        self.hold()
        display = Gdk.Display.get_default()
        monitors = [display.get_monitors().get_item(i) for i in range(display.get_monitors().get_n_items())]
        bg = str(self.cfg["background"])
        want_shots = (self.cfg["fade"] or bg == "screenshot") and shutil.which("grim")
        # the screen as it is, before it is covered
        if want_shots:
            names = [m.get_connector() for m in monitors]
            for name, png in zip(names, self.pool.map(screenshot, names)):
                if png:
                    self.shots[name] = png
        if bg == "wallpaper":
            self.wallpapers = bgmonad_wallpapers()
        GLib.timeout_add_seconds(1, self.tick)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self.on_usr1)
        if self.cfg["music"]:
            self.media = Media(self.on_media)

        if self.preview:
            win = self.make_window(monitors[0] if monitors else None)
            Layer.init_for_window(win)
            Layer.set_layer(win, Layer.Layer.OVERLAY)
            Layer.set_keyboard_mode(win, Layer.KeyboardMode.EXCLUSIVE)
            Layer.set_exclusive_zone(win, -1)
            for edge in (Layer.Edge.TOP, Layer.Edge.BOTTOM, Layer.Edge.LEFT, Layer.Edge.RIGHT):
                Layer.set_anchor(win, edge, True)
            if monitors:
                Layer.set_monitor(win, monitors[0])
            win.present()
            return

        if not SessionLock.is_supported():
            log("the compositor does not support ext-session-lock-v1")
            self.quit()
            sys.exit(1)
        self.lock = SessionLock.Instance.new()
        self.lock.connect("monitor", self.on_monitor)
        self.lock.connect("failed", self.on_failed)
        self.lock.connect("locked", self.on_locked)
        self.lock.connect("unlocked", lambda _l: self.quit())
        self.lock.lock()

    def on_monitor(self, lock, monitor):
        win = self.make_window(monitor)
        lock.assign_window_to_monitor(win, monitor)

    def on_locked(self, _lock):
        with open(LOCKED_FILE, "w") as f:
            f.write(str(os.getpid()))
        tell_idle_daemon_locked()

    def on_failed(self, _lock):
        log("could not lock the session (is it locked already?)")
        self.quit()

    def make_window(self, monitor):
        win = Gtk.Window(application=self)
        win.add_css_class("locklet")
        view = LockView(self, monitor)
        win.set_child(view)
        self.views.append(view)
        win.connect("destroy", lambda _w: self.views.remove(view) if view in self.views else None)
        self.load_background(view, monitor)
        view.media.update(self.media_state, self.cover(self.media_state))
        return win

    # ---- what is playing

    def cover(self, state):
        return self.covers.get(state["art"]) if state and state["art"] else None

    def on_media(self, state):
        self.media_state = state
        for v in self.views:
            v.media.update(state, self.cover(state))
        url = state["art"] if state else ""
        if url and url not in self.covers:
            self.covers[url] = None                 # once, even if it fails
            self.pool.submit(fetch_art, url).add_done_callback(
                lambda fut: GLib.idle_add(self.cover_ready, url, fut.result()))

    def cover_ready(self, url, data):
        if data:
            try:
                self.covers[url] = Gdk.Texture.new_from_bytes(GLib.Bytes.new(data))
            except GLib.Error:
                pass
        if self.media_state and self.media_state["art"] == url:
            for v in self.views:
                v.media.update(self.media_state, self.covers[url])
        return False

    def load_background(self, view, monitor):
        name = monitor.get_connector() if monitor else None
        shot = self.shots.get(name)
        if shot:
            try:
                view.backdrop.shot = Gdk.Texture.new_from_bytes(GLib.Bytes.new(shot))
            except GLib.Error:
                pass
        bg = str(self.cfg["background"])
        if bg.startswith("#"):
            color = Gdk.RGBA()
            if color.parse(bg):
                view.backdrop.color = color
                view.backdrop.dim = 0
            view.backdrop.animation = "none"
            view.backdrop.set_background(None)
            return
        if bg == "screenshot":
            source = shot
        elif bg == "wallpaper":
            source = self.wallpapers.get(name) or os.path.expanduser("~/.config/wallpaper")
        else:
            source = os.path.expanduser(bg)
        if not source or (isinstance(source, str) and not os.path.exists(source)):
            return
        geo = monitor.get_geometry() if monitor else None
        scale = monitor.get_scale() if monitor else 1
        w = int((geo.width if geo else 1920) * scale)
        h = int((geo.height if geo else 1080) * scale)
        blur = float(self.cfg["blur"])
        cfg = self.cfg

        def work():
            if cfg["animation"] == "flow":
                flow = prepare_flow(source, w, h, blur, cfg["flow"], cfg["flow_speed"])
                if flow is not None:
                    return "flow", flow
            return "still", blurred_rgb(source, w, h, blur)

        def done(fut):
            kind, result = fut.result()
            GLib.idle_add(self.background_ready, view, source, kind, result, blur, h)

        self.pool.submit(work).add_done_callback(done)

    def background_ready(self, view, source, kind, result, blur, h):
        if kind == "flow":
            view.backdrop.set_flow(result)
            return False
        if view.backdrop.animation == "flow":      # no Pillow for the flow
            view.backdrop.animation = "drift"
        if result is not None:
            w_, h_, data = result
            tex = Gdk.MemoryTexture.new(w_, h_, Gdk.MemoryFormat.R8G8B8, GLib.Bytes.new(data), w_ * 3)
            view.backdrop.set_background(tex)
            return False
        # no Pillow: let GTK load and blur it (every frame, so it stays still)
        try:
            tex = Gdk.Texture.new_from_bytes(GLib.Bytes.new(source)) if isinstance(source, bytes) \
                else Gdk.Texture.new_from_filename(source)
        except GLib.Error as e:
            log(f"cannot read the background: {e.message}")
            return False
        view.backdrop.animation = "none"
        view.backdrop.set_background(tex, blur_fallback=blur * h / max(1, view.get_scale_factor()))
        return False

    # ---- running

    def tick(self):
        for v in self.views:
            v.tick_clock()
        return GLib.SOURCE_CONTINUE

    def set_status(self, text, error=False):
        for v in self.views:
            v.show_status(text, error)

    def submit(self, password):
        if self.checking or self.unlocking:
            return
        if not password:
            for v in self.views:
                v.shake()
            return
        self.checking = True
        for v in self.views:
            v.set_busy(True)
        self.set_status("")

        def check():
            try:
                ok, why = authenticate(self.service, self.user, password)
            except Exception as e:      # never stay stuck in "checking"
                ok, why = False, f"PAM error: {e}"
            GLib.idle_add(self.checked, ok, why)

        threading.Thread(target=check, daemon=True).start()

    def checked(self, ok, why):
        self.checking = False
        if ok:
            self.unlock()
            return False
        for v in self.views:
            v.set_busy(False)
            v.shake()
        self.set_status(why or "Wrong password", error=True)
        return False

    def on_usr1(self):
        self.unlock()
        return GLib.SOURCE_CONTINUE

    def unlock(self):
        if self.unlocking:
            return
        self.unlocking = True
        for v in self.views:
            v.leave()
        GLib.timeout_add(340, self.finish)

    def finish(self):
        if self.lock is not None:
            self.lock.unlock()       # "unlocked" quits
        else:
            self.quit()
        return False


def main():
    held = None
    if not PREVIEW:
        held = hold(LOCK_FILE)
        if held is None:
            log("already locked")
            return 0
    app = Locklet(PREVIEW)
    code = app.run([sys.argv[0]])
    app.pool.shutdown(wait=False, cancel_futures=True)
    if read_pid(LOCKED_FILE) == os.getpid():
        os.unlink(LOCKED_FILE)
    return code


if __name__ == "__main__":
    sys.exit(main())
