        for b in (self.prev, self.play, self.next):
            controls.append(b)
        box.append(controls)
        self.set_child(box)
        self.url = None

    def button(self, icon, method, css=None):
        b = Gtk.Button(css_classes=[css] if css else [])
        b.set_child(Gtk.Label(label=icon, css_classes=["icon"]))
        b.set_focusable(False)
        b.connect("clicked", lambda _b: self.app.media.control(method))
