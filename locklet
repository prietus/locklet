ACCENT = (0.796, 0.651, 0.969)      # #cba6f7


def ease(t):
    t = min(1.0, max(0.0, t))
    return 1 - (1 - t) ** 3


class Backdrop(Gtk.Widget):
    """The picture behind the lock screen: the screenshot it starts from,
    the blurred background crossfading in over it (flowing, drifting or
    still), and the screenshot again when unlocking. Frames are made only
    when GTK draws, and GTK draws only when the compositor wants a frame:
    with the screen off, nothing is computed."""

    def __init__(self, cfg):
        super().__init__()
        self.cfg = cfg
        self.shot = None            # Gdk.Texture, the screen as it was
        self.bg = None              # Gdk.Texture, blurred (with flow: the last frame)
        self.flow = None            # FlowField
        self.bg_since = None
        self.leave_since = None
        self.blur_fallback = 0      # px, when the blur is done by GTK
        self.dim = float(cfg["dim"])
        self.animation = cfg["animation"]
        self.period = 1e6 / max(1, int(cfg.get("fps") or 30))
        self.color = Gdk.RGBA()
        self.color.parse("#11111b")
        self.last_frame = 0
        self.t0 = time.monotonic()
        self.add_tick_callback(self.on_tick)

    def set_background(self, texture, blur_fallback=0):
        self.bg = texture
        self.blur_fallback = blur_fallback
        # without a screenshot under it, appear from the plain colour
        self.bg_since = time.monotonic()
        self.queue_draw()

    def set_flow(self, flow):
        self.flow = flow
        self.set_background(self.flow_texture())

    def flow_texture(self):
        f = self.flow
        data = f.frame(time.monotonic() - self.t0)
        return Gdk.MemoryTexture.new(f.width, f.height, Gdk.MemoryFormat.R8G8B8,
                                     GLib.Bytes.new(data), f.width * 3)

    def leave(self):
        self.leave_since = time.monotonic()
        self.queue_draw()

    def animating(self, now):
        moving = self.bg is not None and (self.flow is not None or self.animation == "drift")
        return moving \
            or (self.bg_since is not None and now - self.bg_since < 1.0) \
            or self.leave_since is not None

    def on_tick(self, _w, clock):
        now_us = clock.get_frame_time()
        now = time.monotonic()
        if self.animating(now):
            # flow and drift move a fraction of a pixel a frame: fps is plenty
            transitioning = (self.bg_since and now - self.bg_since < 1.0) or self.leave_since
            if transitioning or now_us - self.last_frame >= self.period:
                self.last_frame = now_us
                if self.flow is not None and self.leave_since is None:
                    self.bg = self.flow_texture()
                self.queue_draw()
        return GLib.SOURCE_CONTINUE

    def cover(self, snapshot, tex, w, h, zoom=1.0, dx=0.0, dy=0.0):
        tw, th = tex.get_width(), tex.get_height()
        s = max(w / tw, h / th) * zoom
        rw, rh = tw * s, th * s
        rect = Graphene.Rect().init((w - rw) / 2 + dx, (h - rh) / 2 + dy, rw, rh)
        snapshot.append_texture(tex, rect)

    def do_snapshot(self, snapshot):
        w, h = self.get_width(), self.get_height()
        full = Graphene.Rect().init(0, 0, w, h)
        now = time.monotonic()
        snapshot.append_color(self.color, full)
        if self.shot is not None:
            self.cover(snapshot, self.shot, w, h)
        if self.bg is not None:
            a = ease((now - self.bg_since) / 0.9) if self.bg_since else 1.0
            snapshot.push_clip(full)
            snapshot.push_opacity(a)
            if self.animation == "drift" and self.flow is None:
                t = now - self.t0
                zoom = 1.08 + 0.025 * math.sin(2 * math.pi * t / 47)
                dx = 0.016 * w * math.sin(2 * math.pi * t / 61 + 1.0)
                dy = 0.012 * h * math.cos(2 * math.pi * t / 53)
            else:
                zoom, dx, dy = 1.06 if self.blur_fallback else 1.0, 0.0, 0.0
            if self.blur_fallback:
                snapshot.push_blur(self.blur_fallback)
            self.cover(snapshot, self.bg, w, h, zoom, dx, dy)
            if self.blur_fallback:
                snapshot.pop()
            dim = Gdk.RGBA()
            dim.red, dim.green, dim.blue, dim.alpha = 0.067, 0.067, 0.106, self.dim
            snapshot.append_color(dim, full)
            snapshot.pop()
            snapshot.pop()
        if self.leave_since is not None and self.shot is not None:
            snapshot.push_opacity(ease((now - self.leave_since) / 0.32))
            self.cover(snapshot, self.shot, w, h)
            snapshot.pop()


class Avatar(Gtk.DrawingArea):
    def __init__(self, path, name, size=96):
        super().__init__()
        self.set_content_width(size)
        self.set_content_height(size)
        self.add_css_class("avatar")
        self.set_halign(Gtk.Align.CENTER)
        self.pixbuf = None
        if path:
            try:
                self.pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size * 2, size * 2, True)
            except GLib.Error:
                pass
        self.initial = (name.strip()[:1] or "?").upper()
        self.set_draw_func(self.draw)

    def draw(self, _area, cr, w, h):
        r = min(w, h) / 2
        cx, cy = w / 2, h / 2
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.clip()
        if self.pixbuf is not None:
            pw, ph = self.pixbuf.get_width(), self.pixbuf.get_height()
            s = max(w / pw, h / ph)
            cr.translate(cx - pw * s / 2, cy - ph * s / 2)
            cr.scale(s, s)
            Gdk.cairo_set_source_pixbuf(cr, self.pixbuf, 0, 0)
            cr.paint()
            cr.identity_matrix()
        else:
            import cairo
            g = cairo.LinearGradient(0, 0, w, h)
            g.add_color_stop_rgb(0, *ACCENT)
            g.add_color_stop_rgb(1, 0.537, 0.706, 0.980)      # #89b4fa
            cr.set_source(g)
            cr.paint()
            cr.set_source_rgba(0.118, 0.118, 0.180, 0.92)    # #1e1e2e
            cr.select_font_face("Inter", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(r * 0.95)
            ext = cr.text_extents(self.initial)
            cr.move_to(cx - ext.width / 2 - ext.x_bearing, cy - ext.height / 2 - ext.y_bearing)
            cr.show_text(self.initial)
        # a thin light ring
        cr.reset_clip()
        cr.new_path()
        cr.arc(cx, cy, r - 0.75, 0, 2 * math.pi)
        cr.set_source_rgba(1, 1, 1, 0.22)
        cr.set_line_width(1.5)
        cr.stroke()


class Media:
    """What is playing, from the MPRIS players on the session bus (spotify,
    mpv with mpv-mpris, firefox, mpd with mpDris2...). `changed(state)` is
    called with a dict, or None when nothing is playing or paused. The one
    shown is the player playing (the one that started last), else the last
    one paused."""

    PREFIX = "org.mpris.MediaPlayer2."
    PATH = "/org/mpris/MediaPlayer2"
    PLAYER = "org.mpris.MediaPlayer2.Player"

    def __init__(self, changed):
        from gi.repository import Gio
        self.Gio = Gio
        self.changed = changed
        self.players = {}           # bus name -> state
        self.recent = []            # bus names, the last to change state first
        self.current = None
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except GLib.Error as e:
            log(f"music: no session bus ({e.message})")
            self.bus = None
            return
        self.bus.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged",
                                  "/org/freedesktop/DBus", None, Gio.DBusSignalFlags.NONE, self.on_owner)
        # which player changed is not said by name: refresh them all (few)
        self.bus.signal_subscribe(None, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                                  self.PATH, self.PLAYER, Gio.DBusSignalFlags.NONE,
                                  lambda *_a: [self.refresh(n) for n in list(self.players)])
        self.bus.call("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "ListNames",
                      None, GLib.VariantType("(as)"), Gio.DBusCallFlags.NONE, -1, None, self.on_names)

    def wanted(self, name):
        # playerctld mirrors the other players: it would show everything twice
        return name.startswith(self.PREFIX) and "playerctld" not in name

    def on_names(self, bus, res):
        try:
            names = bus.call_finish(res).unpack()[0]
        except GLib.Error:
            return
        for n in names:
            if self.wanted(n):
                self.refresh(n)

    def on_owner(self, _c, _s, _p, _i, _n, params):
        name, _old, new = params.unpack()
        if not self.wanted(name):
            return
        if new:
            self.refresh(name)
        else:
            self.players.pop(name, None)
            self.update()

    def refresh(self, name):
        self.bus.call(name, self.PATH, "org.freedesktop.DBus.Properties", "GetAll",
                      GLib.Variant("(s)", (self.PLAYER,)), GLib.VariantType("(a{sv})"),
                      self.Gio.DBusCallFlags.NONE, 2000, None, lambda b, r: self.got(name, b, r))

    def got(self, name, bus, res):
        try:
            props = bus.call_finish(res).unpack()[0]
        except GLib.Error:
            return
        md = props.get("Metadata") or {}
        artist = md.get("xesam:artist") or []
        if isinstance(artist, str):
            artist = [artist]
        state = {
            "name": name,
            "player": name[len(self.PREFIX):].split(".")[0].capitalize(),
            "status": props.get("PlaybackStatus", "Stopped"),
            "title": str(md.get("xesam:title") or ""),
            "artist": ", ".join(str(a) for a in artist),
            "art": str(md.get("mpris:artUrl") or ""),
            "can_prev": bool(props.get("CanGoPrevious", True)),
            "can_next": bool(props.get("CanGoNext", True)),
        }
        old = self.players.get(name)
        if old is None or old["status"] != state["status"]:
            if name in self.recent:
                self.recent.remove(name)
            self.recent.insert(0, name)
        self.players[name] = state
        self.update()

    def update(self):
        order = [n for n in self.recent if n in self.players] + \
                [n for n in self.players if n not in self.recent]
        pick = None
        for status in ("Playing", "Paused"):
            pick = next((self.players[n] for n in order
                         if self.players[n]["status"] == status
                         and (self.players[n]["title"] or self.players[n]["artist"])), None)
            if pick:
                break
        if pick != self.current:
            self.current = pick
            self.changed(pick)

    def control(self, method):
        if self.bus is not None and self.current is not None:
            self.bus.call(self.current["name"], self.PATH, self.PLAYER, method, None, None,
                          self.Gio.DBusCallFlags.NONE, 2000, None, None)


def fetch_art(url):
    """The bytes of a cover, from file:// or http(s)://; None if it cannot
    be had quickly. Runs in a thread."""
    try:
        if url.startswith("file://"):
            path = GLib.filename_from_uri(url)[0]
            if os.path.getsize(path) > 20 << 20:
                return None
            with open(path, "rb") as f:
                return f.read()
        if url.startswith(("http://", "https://")):
            import urllib.request
            with urllib.request.urlopen(url, timeout=4) as r:
                return r.read(10 << 20)
    except Exception:
        pass
    return None


class MediaCard(Gtk.Revealer):
    """The cover, the title and the artist, with previous / play-pause /
    next. The buttons never take the keyboard: the password field keeps it."""

    def __init__(self, app):
        super().__init__(transition_type=Gtk.RevealerTransitionType.CROSSFADE, transition_duration=350)
        self.app = app
        self.set_halign(Gtk.Align.CENTER)
        box = Gtk.Box(css_classes=["media"], spacing=14)

        self.art_stack = Gtk.Stack(css_classes=["art"])
        self.art_stack.set_overflow(Gtk.Overflow.HIDDEN)
        self.art_stack.set_size_request(64, 64)
        self.art_stack.set_valign(Gtk.Align.CENTER)
        # a Gtk.Picture would ask for the size of the cover; this is 64 px
        self.picture = Gtk.Image(pixel_size=64)
        self.art_stack.add_named(Gtk.Label(label="music_note", css_classes=["icon"]), "none")
        self.art_stack.add_named(self.picture, "art")
